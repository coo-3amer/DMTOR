{
  "manifest_version": 3,
  "name": "MZ-DManager",
  "version": "1.9.1",
  "description": "Sends your downloads, videos and torrents to the MZ-DManager app.",
  "permissions": ["downloads", "contextMenus", "cookies", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MZ-DManager",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["click.js"], "run_at": "document_start", "all_frames": true },
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
